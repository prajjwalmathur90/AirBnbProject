PORT=3000
NODE_ENV=development

# ─── MySQL Docker ────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword

# ─── Application Database Credentials ───────────────────
DATABASE_USER=appuser
DATABASE_PASSWORD=apppassword
DATABASE_NAME=airbnb_dev
DATABASE_HOST=localhost
DATABASE_PORT=3306

# ─── Prisma ─────────────────────────────────────────────
DATABASE_URL="mysql://root:rootpassword@localhost:3306/airbnb_dev?allowPublicKeyRetrieval=true"
